{
  "name": "typescript-extractor-mcp",
  "version": "1.0.0",
  "description": "MCP server for extracting TypeScript imports and method bodies",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "test": "node --loader ts-node/esm test-examples/test-extractor.ts",
    "start": "node build/index.js"
  },
  "keywords": [
    "mcp",
    "typescript",
    "extraction",
    "claude-code"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ts-morph": "^24.0.0",
    "express": "^4.18.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "@types/node": "^22.10.5",
    "@types/express": "^4.17.21",
    "typescript": "^5.7.2"
  }
}
